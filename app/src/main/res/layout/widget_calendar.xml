<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:padding="13dp"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title"
        android:text="КАЛЕНДАР УПЦ КП" android:letterSpacing="0.07"
        android:textColor="#A9C3F2" android:textSize="11sp" android:textStyle="bold"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/widget_date" android:textColor="#FFFFFF"
        android:textSize="21sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/widget_saints" android:textColor="#EBE7DF"
        android:textSize="13sp" android:maxLines="3" android:ellipsize="end"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
