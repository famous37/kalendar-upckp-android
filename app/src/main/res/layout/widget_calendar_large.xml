<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:orientation="vertical" android:gravity="center_vertical"
    android:padding="19dp" android:background="@drawable/widget_background"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_title" android:text="ПРАВОСЛАВНИЙ КАЛЕНДАР · УПЦ КП"
        android:textSize="11sp" android:textColor="#EAC582" android:textStyle="bold"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_date" android:textColor="#FFFFFF"
        android:textSize="27sp" android:textStyle="bold" android:maxLines="1"
        android:ellipsize="end" android:layout_marginTop="7dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_civil" android:textColor="#C6D2DD"
        android:textSize="13sp" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_saints" android:textColor="#FFFFFF"
        android:textSize="16sp" android:maxLines="5" android:ellipsize="end"
        android:layout_marginTop="12dp" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView android:id="@+id/widget_fast" android:textColor="#EAC582"
        android:textSize="13sp" android:layout_marginTop="9dp"
        android:maxLines="2" android:ellipsize="end" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>